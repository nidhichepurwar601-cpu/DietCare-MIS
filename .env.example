# ============================================================
#  DietCare MIS — API Configuration TEMPLATE
#  Copy this file to ".env" and fill in your values.
#  Never commit ".env" to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
VITE_API_HOST=192.168.1.14        # IP or hostname of the backend
VITE_API_PORT=8085                 # Port the backend listens on
VITE_API_BASE_PATH=/dietcare       # Context path prefix

# ── Auth headers ─────────────────────────────────────────────
VITE_API_USER_ID=aureus
VITE_API_CLINIC_ID=aureus
VITE_API_ZONE_ID=aureus
VITE_API_AUTH_TOKEN=SmartCare <paste-token-here>

# ── Request settings ─────────────────────────────────────────
VITE_API_TIMEOUT_MS=20000
