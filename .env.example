# ============================================================
#  DietCare MIS — API Configuration TEMPLATE
#  Copy this file to ".env" and fill in your values.
#  Never commit ".env" to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
VITE_API_PROTOCOL=http             # http or https
VITE_API_HOST=                     # Backend IP or hostname (no protocol required)
VITE_API_PORT=                     # Backend port; leave blank for default
VITE_API_BASE_PATH=/dietcare        # Context path prefix

# Production builds also include public/runtime-config.js. Edit the matching
# values in dist/runtime-config.js to change the backend without rebuilding.
# Auth headers are never configured here; set them in sessionStorage at login.

# ── Request settings ─────────────────────────────────────────
VITE_API_TIMEOUT_MS=20000
